# Copy to .env.docker (gitignored) and adjust before `docker compose up`.
# docker compose --env-file .env.docker up --build -d

# SQL Server SA password (must meet SQL complexity rules)
MSSQL_SA_PASSWORD=Your_strong_Password123
MSSQL_PORT=1433

# Host ports
BACKEND_PORT=8001
FRONTEND_PORT=8080

# Must match the key baked into the frontend image (VITE_API_KEY build-arg)
API_KEY=change-me-local-api-key

# Optional AI features
# GROQ_API_KEY=

# Browser origins allowed to call the API directly (UI normally uses nginx /api proxy)
FASTAPI_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
