# Copy to .env and fill in local values. Do not commit secrets.

# SQL — either set a full ODBC string, or SQL_SERVER + SQL_DB (built at runtime).
# SQL_CONNECTION_STRING=DRIVER={ODBC Driver 17 for SQL Server};SERVER=...;DATABASE=...;Trusted_Connection=yes;TrustServerCertificate=yes;
# AZURE_SQL_CONNECTION_STRING=...
SQL_SERVER=YOUR_SERVER\INSTANCE
SQL_DB=YOUR_DATABASE
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=true
SQL_TRUST_SERVER_CERTIFICATE=true
# SQL_UID=
# SQL_PWD=
# SQL_ENCRYPT=false

# Docker SQL integration tests (docker compose + database/docker/apply_schema.ps1):
# SQL_SERVER=localhost,1433
# SQL_DB=Benchmarking
# SQL_TRUSTED_CONNECTION=false
# SQL_UID=sa
# SQL_PWD=Your_strong_Password123
# SQL_ENCRYPT=false
# RUN_SQL_INTEGRATION=1

DB_LOCK_TIMEOUT_MS=15000
PROCESS_ADJUSTMENTS=0
DEBUG_LEVEL2=0
# LOCAL_TEST_FILE_PATH=path\to\workbook.xlsx

# API — Vite (5173) → proxied to FastAPI (8001)
FASTAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Basic API protection (required for /api/ai/* and /api/ingestion/upload)
# Frontend needs the same value as VITE_API_KEY in frontend/.env
API_KEY=change-me-local-api-key
# UPLOAD_MAX_BYTES=20971520
# API_RATE_LIMIT_AI=20/minute
# API_RATE_LIMIT_UPLOAD=10/minute

# Runtime artifacts (saved report drafts + DOCX/PDF exports). Relative paths are from repo root.
# DATA_DIR=data
# → data/saved_drafts/*.json and data/exports/*.docx|*.pdf

# Optional integrations
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE_NARRATIVE=0.2
# GROQ_TEMPERATURE_SQL=0.1
# GROQ_TEMPERATURE_SQL_STRICT=0.0

# AI SQL assistant — dedicated read-only login (required for /api/ai/query; no ingestion fallback)
# Create with: database/security/001_ai_readonly_login.sql (password is a sqlcmd -v parameter)
# AI_SQL_USER=ai_readonly
# AI_SQL_PASSWORD=
# AI_SQL_SERVER=YOUR_SERVER\INSTANCE
# AI_SQL_DATABASE=YOUR_DATABASE
# AI_SQL_MAX_ROWS=500
# AI_SQL_QUERY_TIMEOUT_S=30

# Power BI SQL login (created via database/security/002_pbi_readonly_login.sql; not used by the app)
# PBI_SQL_USER=pbi_readonly
