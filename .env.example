# Copy to .env and fill in local values. Do not commit .env.
#   copy .env.example .env
#
# Frontend API key must match: see frontend/.env.example (VITE_API_KEY).
# Branding can also use branding.yaml (copy from branding.example.yaml).

# -----------------------------------------------------------------------------
# SQL (ingestion / backend)
# Prefer SQL_SERVER + SQL_DB, or set a full ODBC override string.
# -----------------------------------------------------------------------------
# SQL_CONNECTION_STRING=
# AZURE_SQL_CONNECTION_STRING=

SQL_SERVER=YOUR_SERVER\INSTANCE
SQL_DB=YOUR_DATABASE
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Windows / local SQLEXPRESS style (Trusted_Connection). Leave UID/PWD empty.
SQL_TRUSTED_CONNECTION=true
SQL_TRUST_SERVER_CERTIFICATE=true
# SQL_ENCRYPT=

# SQL authentication (Docker / remote). Set TRUSTED_CONNECTION=false and fill both:
# SQL_TRUSTED_CONNECTION=false
SQL_UID=
SQL_PWD=

# Docker SQL from the host (compose publishes 1433):
# SQL_SERVER=localhost,1433
# SQL_DB=Benchmarking
# SQL_TRUSTED_CONNECTION=false
# SQL_UID=sa
# SQL_PWD=
# SQL_DRIVER=ODBC Driver 18 for SQL Server
# SQL_ENCRYPT=false
# RUN_SQL_INTEGRATION=1
# SQL_SCHEMA_APPLIED=1

DB_LOCK_TIMEOUT_MS=15000
PROCESS_ADJUSTMENTS=0
DEBUG_LEVEL2=0
# LOCAL_TEST_FILE_PATH=

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
FASTAPI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for /api/ai/* and /api/ingestion/upload. No default — set explicitly.
# Must match frontend VITE_API_KEY.
API_KEY=

# UPLOAD_MAX_BYTES=20971520
# API_RATE_LIMIT_AI=20/minute
# API_RATE_LIMIT_UPLOAD=10/minute

# Drafts / exports (relative to repo root, or absolute)
# DATA_DIR=data

# -----------------------------------------------------------------------------
# Groq (AI report draft + AI SQL NL→SQL)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TEMPERATURE_NARRATIVE=0.2
# GROQ_TEMPERATURE_SQL=0.1
# GROQ_TEMPERATURE_SQL_STRICT=0.0

# -----------------------------------------------------------------------------
# AI SQL assistant — dedicated read-only login (required for /api/ai/query)
# Create with: database/security/001_ai_readonly_login.sql
# No fallback to the ingestion SQL login.
# -----------------------------------------------------------------------------
AI_SQL_USER=
AI_SQL_PASSWORD=
AI_SQL_SERVER=
AI_SQL_DATABASE=
# AI_SQL_DRIVER=ODBC Driver 17 for SQL Server
# AI_SQL_MAX_ROWS=500
# AI_SQL_QUERY_TIMEOUT_S=30

# -----------------------------------------------------------------------------
# Branding (optional — or use branding.yaml from branding.example.yaml)
# -----------------------------------------------------------------------------
# BRAND_COMPANY_NAME=
# BRAND_REGISTRATION_NUMBER=
# BRAND_WEBSITE=
# BRAND_LOGO_PATH=backend/app/reporting/assets/logos/company_logo.png
# BRAND_FONT_FAMILY=Archivo
# BRAND_FONT_BODY_FILE=Archivo_Expanded-Light.ttf
# BRAND_FONT_HEADING_FILE=Archivo_Expanded-Bold.ttf
# BRAND_ACCENT_COLOUR=#32c3e2
# BRAND_LEGAL_FOOTER_LINES=
